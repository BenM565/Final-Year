# Copy to .env for local development. Never commit the real .env.
# On Render, set these in the service's Environment tab instead.

# Leave unset to fall back to a local SQLite file (instance/step.db).
# On Render, use the Postgres "Internal Database URL".
DATABASE_URL=

# Any long random string; sessions are invalidated when it changes.
SECRET_KEY=

# Public base URL used in outgoing email links.
APP_URL=http://localhost:5000

# Email (Gmail app password, not your account password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Optional payments
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
